      "type": "396",
      "height": 363,
      "top": 3268,
      "text": "СЕРЕЖА ОЧЕНЬ ТУПОЙ"
    },
    {
      "id": "rec402966983",
      "type": "396",
      "height": 363,
      "top": 3631,
      "text": "ШОУ-РУМ"
    },
    {
      "id": "rec404032782",
      "type": "396",
      "height": 363,
      "top": 3994,
      "text": "ПОНАЕХИ"
    },
    {
      "id": "rec402967956",
      "type": "396",
      "height": 363,
      "top": 4357,
      "text": "МНЕ МОЕ СОЛНЫШКО БОЛЬШЕ НЕ СВЕТИТ"
    },
    {
      "id": "rec398282388",
      "type": "396",
      "height": 363,
      "top": 4720,
      "text": "КВАЗИФУТБОЛ"
    },
    {
      "id": "rec393277991",
      "type": "396",
      "height": 363,
      "top": 5083,
      "text": "СЕРАЯ РАДУГА"
    },
    {
      "id": "rec398282396",
      "type": "396",
      "height": 363,
      "top": 5446,
      "text": "Я УМЕР ОТ ВАРЕНЬЯ"
    },
    {
      "id": "rec398282387",
      "type": "396",
      "height": 363,
      "top": 5809,
      "text": "С УЧИЛИЩА"
