    {
      "id": "rec732750784",
      "type": "396",
      "height": 363,
      "top": 2542,
      "text": "ПАХЛАВА ГЛУПОСТИ\nСпектакли Одного театра"
    },
    {
      "id": "rec398282386",
      "type": "396",
      "height": 363,
      "top": 2905,
      "text": "ТОКСИНЫ\nСпектакли Одного театра"
    },
    {
