    {
      "id": "rec398282431",
      "type": "396",
      "height": 363,
      "top": 9802,
      "text": "ВИТАМИН РОСТА"
    },
    {
      "id": "rec525200326",
      "type": "396",
      "height": 363,
      "top": 10165,
