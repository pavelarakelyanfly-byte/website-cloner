      "type": "396",
      "height": 363,
      "top": 6898,
      "text": "ТЕБЯ 2"
    },
    {
      "id": "rec398282398",
      "type": "396",
      "height": 363,
      "top": 7261,
      "text": "ЗАТВОРНИК И ШЕСТИПАЛЫЙ"
    },
    {
      "id": "rec398282399",
      "type": "396",
      "height": 363,
      "top": 7624,
      "text": "ГДЕ-ТО И ОКОЛО"
    },
    {
      "id": "rec398282434",
      "type": "396",
      "height": 363,
      "top": 7987,
      "text": "ПАРАЛЛЕЛИ"
    },
    {
      "id": "rec398282397",
      "type": "396",
      "height": 363,
      "top": 8350,
      "text": "НЕБЕСНЫЕ БЕГЛЕЦЫ"
    },
    {
      "id": "rec398282429",
      "type": "396",
      "height": 363,
      "top": 8713,
      "text": "ГОРОД. ОТКРЫТОЕ НЕБО"
    },
    {
      "id": "rec398282440",
      "type": "396",
      "height": 363,
      "top": 9076,
      "text": "НЕВИДИМЫЙ КРАСНОДАР"
    },
    {
      "id": "rec402966375",
      "type": "396",
      "height": 363,
      "top": 9439,
      "text": "ПОЛНОЕ СЧАСТЬЕ"
