    {
      "id": "rec1873148391",
      "type": "396",
      "height": 0,
      "top": 0,
      "text": "МЫ\nЗРИТЕЛЯМ\nТЕАТР\nКОНТАКТЫ\nСПЕКТАКЛИ"
    },
    {
      "id": "rec561068918",
      "type": "396",
      "height": 1,
      "top": 0,
      "text": "МЫ\nЗРИТЕЛЯМ\nТЕАТР\nКОНТАКТЫ\nСПЕКТАКЛИ"
    },
    {
      "id": "rec409482507",
      "type": "396",
      "height": 1700,
      "top": 1,
      "text": "один театр - это независимый театр, генерирующий на своей базе актуальные спектакли и другие формы современного искусства.\nО театре"
    },
    {
      "id": "rec409480901",
      "type": "396",
      "height": 1700,
      "top": 1701,
      "text": "наша задача создавать условия, в которых зритель перестаёт быть потребителем театрального действия, а становится его непосредственным участником."
    },
    {
      "id": "rec409486534",
      "type": "396",
      "height": 1700,
      "top": 3401,
      "text": "наш театр для тех, кто готов вместе с нами исследовать себя и окружающую действительность."
    },
    {
      "id": "rec409484994",
      "type": "396",
      "height": 1000,
      "top": 5101,
      "text": ""
    },
    {
      "id": "rec379129372",
      "type": "389",
      "height": 200,
      "top": 6101,
      "text": "\t\nМЫ ГЛАВНАЯ АФИША СПЕКТАКЛИ ТЕАТР ЗРИТЕЛЯМ КОНТАКТЫ\n\t"
